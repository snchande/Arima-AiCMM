{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicmm.org/schemas/agent-card.schema.json",
  "title": "AiCMM Agent Card",
  "description": "Schema for an AiCMM Agent Capability Card describing an AI agent's capability fingerprint",
  "type": "object",
  "required": ["schemaVersion", "agent", "capabilityProfile"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.2.0",
      "description": "Version of the AiCMM Agent Card schema"
    },
    "agent": {
      "type": "object",
      "required": ["name", "category", "description"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the agent"
        },
        "version": {
          "type": "string",
          "description": "Version of the agent being evaluated"
        },
        "vendor": {
          "type": "string",
          "description": "Organization or individual that created the agent"
        },
        "description": {
          "type": "string",
          "description": "Brief description of the agent's purpose"
        },
        "category": {
          "type": "string",
          "enum": ["digital", "embodied", "hybrid"],
          "description": "Primary category of the agent"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL for more information about the agent"
        }
      }
    },
    "capabilityProfile": {
      "type": "object",
      "description": "The twelve core AiCMM dimensions, fixed at positions 0-11. The derived Agency Qualification (position 12) is described separately under 'agencyQualification'.",
      "required": ["autonomy", "reasoning", "memory", "learning", "toolUse", "collaboration", "embodiment", "explainability", "safety", "interoperability", "costEfficiency", "domainAlignment"],
      "properties": {
        "autonomy": { "$ref": "#/$defs/dimensionScore" },
        "reasoning": { "$ref": "#/$defs/dimensionScore" },
        "memory": { "$ref": "#/$defs/dimensionScore" },
        "learning": { "$ref": "#/$defs/dimensionScore" },
        "toolUse": { "$ref": "#/$defs/dimensionScore" },
        "collaboration": { "$ref": "#/$defs/dimensionScore" },
        "embodiment": { "$ref": "#/$defs/dimensionScore" },
        "explainability": { "$ref": "#/$defs/dimensionScore" },
        "safety": { "$ref": "#/$defs/dimensionScore" },
        "interoperability": { "$ref": "#/$defs/dimensionScore" },
        "costEfficiency": { "$ref": "#/$defs/dimensionScore" },
        "domainAlignment": { "$ref": "#/$defs/dimensionScore" }
      }
    },
    "agencyQualification": {
      "$ref": "#/$defs/agencyQualification",
      "description": "Derived 13th dimension (position 12): the Agency Qualification Layer. Classifies whether the system is a genuine agent and how agentic it is, computed from the twelve core scores. Never authored by hand."
    },
    "operationalConstraints": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "description": "Operating domain (e.g., healthcare, logistics, finance)"
        },
        "safetyClass": {
          "type": "string",
          "description": "Safety classification level"
        },
        "approvalRequirements": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Human approval gates required"
        },
        "regulatoryFrameworks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Applicable regulatory frameworks (e.g., HIPAA, ISO 26262)"
        }
      }
    },
    "capabilityResume": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "date", "scores"],
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "scores": { "$ref": "#/$defs/scoreSet" },
          "notes": { "type": "string" }
        }
      },
      "description": "Historical capability scores across versions"
    },
    "integration": {
      "type": "object",
      "properties": {
        "a2aCompatible": {
          "type": "boolean",
          "description": "Whether this card is embeddable in A2A protocol"
        },
        "mcpEndpoints": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "description": "MCP server endpoints for this agent"
        }
      }
    },
    "assessmentMetadata": {
      "type": "object",
      "properties": {
        "assessedBy": { "type": "string" },
        "assessedDate": { "type": "string", "format": "date" },
        "methodology": { "type": "string" },
        "evidenceSources": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "agencyQualification": {
      "type": "object",
      "description": "Derived Agency Qualification Layer (position 12). Computed from the twelve core dimension scores via the AiCMM agency algorithm; not authored directly.",
      "required": ["level"],
      "properties": {
        "position": { "type": "integer", "const": 12 },
        "dimension": { "type": "string", "const": "Agency Qualification" },
        "derived": { "type": "boolean", "const": true },
        "level": {
          "type": "integer",
          "minimum": -2,
          "maximum": 5,
          "description": "Signed agency ladder: -2 Scripted Automation, -1 Reactive Assistant, 0 Proto-Agent, 1 Basic Agent, 2 Advanced Agent, 3 Generalized Agent, 4 Human-Level Agent, 5 Humanoid Agent"
        },
        "code": {
          "type": "string",
          "enum": ["SCRIPTED_AUTOMATION", "REACTIVE_ASSISTANT", "PROTO_AGENT", "BASIC_AGENT", "ADVANCED_AGENT", "GENERALIZED_AGENT", "HUMAN_LEVEL_AGENT", "HUMANOID_AGENT"]
        },
        "label": { "type": "string", "description": "Human-readable agency level label" },
        "isAgent": { "type": "boolean", "description": "True when level >= 0 (clears the agent threshold: Autonomy >= 2 and Reasoning >= 2)" },
        "governancePass": { "type": "boolean", "description": "Whether all seven governance rules passed" },
        "index": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Weighted Agency Index barometer reading (0-100) derived from the twelve scores; expresses momentum within a band." },
        "needle": { "type": "number", "minimum": -2, "maximum": 5, "description": "Continuous needle position on the signed -2..+5 ladder, for barometer rendering." },
        "rationale": { "type": "string", "description": "Explanation of why this agency level was assigned" }
      }
    },
    "dimensionScore": {
      "type": "object",
      "required": ["score"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Capability score (0=absent, 5=state of the art)"
        },
        "evidence": {
          "type": "string",
          "description": "Observable evidence justifying this score"
        },
        "constraints": {
          "type": "string",
          "description": "Intentional constraints on this dimension"
        }
      }
    },
    "scoreSet": {
      "type": "object",
      "properties": {
        "autonomy": { "type": "integer", "minimum": 0, "maximum": 5 },
        "reasoning": { "type": "integer", "minimum": 0, "maximum": 5 },
        "memory": { "type": "integer", "minimum": 0, "maximum": 5 },
        "learning": { "type": "integer", "minimum": 0, "maximum": 5 },
        "toolUse": { "type": "integer", "minimum": 0, "maximum": 5 },
        "collaboration": { "type": "integer", "minimum": 0, "maximum": 5 },
        "embodiment": { "type": "integer", "minimum": 0, "maximum": 5 },
        "explainability": { "type": "integer", "minimum": 0, "maximum": 5 },
        "safety": { "type": "integer", "minimum": 0, "maximum": 5 },
        "interoperability": { "type": "integer", "minimum": 0, "maximum": 5 },
        "costEfficiency": { "type": "integer", "minimum": 0, "maximum": 5 },
        "domainAlignment": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    }
  }
}
